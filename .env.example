# Copy to `.env` and edit. `.env` is git-ignored.
# Every value is optional — sensible defaults live in config.py.

# ---- Database ----
# Leave unset to use a local SQLite file (zero setup). Set it to a Postgres /
# Supabase connection string to use Postgres (required for the cloud deploy).
# Use the Supabase *pooler* URL for serverless/CI. Example:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---- What to scrape / how often ----
# OI_SOURCE_URL=http://openinsider.com/latest-insider-purchases-25k
# OI_POLL_INTERVAL=600          # seconds between scrapes (default 600 = 10 min)

# ---- Thresholds (the "large company / large trade" focus) ----
# OI_MIN_TRADE_VALUE=1000000    # only store buys >= $1,000,000
# OI_MIN_MARKET_CAP=2000000000  # alerts only for companies >= $2B
# OI_ALERT_MIN_SCORE=70         # 0-100 model score needed to alert

# ---- Notifications ----
# OI_NOTIFY_TERMINAL=true
# OI_NOTIFY_DESKTOP=true        # macOS notification centre
# OI_NOTIFY_EMAIL=false         # set true once SMTP is filled in below

# ---- Email (Gmail example; use an App Password, not your login password) ----
# OI_SMTP_HOST=smtp.gmail.com
# OI_SMTP_PORT=587
# OI_SMTP_USER=you@gmail.com
# OI_SMTP_PASS=your_app_password
# OI_SMTP_USE_TLS=true
# OI_ALERT_FROM=you@gmail.com
# OI_ALERT_TO=you@gmail.com,someone@else.com

# ---- Dashboard ----
# OI_WEB_HOST=127.0.0.1
# OI_WEB_PORT=8787
