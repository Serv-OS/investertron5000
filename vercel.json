{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "**/*.py"
    },
    "api/poll.py": {
      "includeFiles": "**/*.py",
      "maxDuration": 300
    }
  },
  "crons": [
    { "path": "/api/poll", "schedule": "0 23 * * *" }
  ],
  "rewrites": [
    { "source": "/((?!api/poll).*)", "destination": "/api/index" }
  ]
}
